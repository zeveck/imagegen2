.env
.imagegen2-history.jsonl
.imagegen-history.jsonl
generated-images/
plans/

# Local assistant/tool state
.claude/

# Local checkouts of sibling repos
imagegen/
nanogen/
audiogen/
anim8gen/

# Playwright CLI output (may contain credentials). The CLI writes to
# .playwright-cli/ by default; .playwright/cli.config.json redirects it to
# .playwright/output/.
.playwright-cli/
.playwright/output/

# Regenerated by VS Code on each container build; the base image tag floats,
# so pinning only the feature digests adds churn without reproducibility.
.devcontainer/devcontainer-lock.json
